# OpenAI 兼容图像 API 中转站
OPENAI_BASE_URL=https://tyaiapi.com/v1
OPENAI_API_KEY=

# 本地 Docker Compose PostgreSQL，先从项目根目录执行 docker compose up -d db
DATABASE_URL=postgresql+asyncpg://ai_change_map:local_dev_only@127.0.0.1:5433/ai_change_map

# JWT_SECRET_KEY 请填写至少 32 位随机字符串，不要使用示例值
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10080

# 启动时自动创建或同步管理员账号
ADMIN_USERNAME=
ADMIN_PHONE=
ADMIN_PASSWORD=

# 逗号分隔的额外管理员用户名/手机号，可留空
ADMIN_USERNAMES=
ADMIN_PHONES=

# 本地开发前端地址；正式部署填写网站来源
CORS_ALLOWED_ORIGINS=http://localhost:5174
