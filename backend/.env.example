# OpenAI-compatible / GPT-Image-2 配置
# OPENAI_BASE_URL 可填写第三方 OpenAI 兼容中转站地址，例如 https://ainx.chat/v1
OPENAI_API_KEY=your_openai_compatible_api_key_here
OPENAI_BASE_URL=https://ainx.chat/v1
# 默认编辑使用 providers.yaml 中的 openai_1k：gpt-image-2-1k + /images/edits multipart。
# 兼容旧环境变量；通常无需再通过 OPENAI_MODEL 切换模型。
OPENAI_MODEL=gpt-image-2-1k

# 旧变量仍兼容：未设置 OPENAI_* 时可继续使用 AINX_*
AINX_API_BASE=https://ainx.chat/v1
AINX_API_KEY=your_ainx_api_key_here

# Gemini / 豆包 SeedEdit 走云雾
YUNWU_API_BASE=https://yunwu.ai/v1
YUNWU_GEMINI_API_BASE=https://yunwu.ai/v1beta
YUNWU_API_KEY=your_yunwu_api_key_here

# 旧变量仍兼容
RELAY_API_BASE=https://ainx.chat/v1
GEMINI_API_KEY=your_yunwu_api_key_here

# 数据库
DATABASE_URL=sqlite+aiosqlite:///./db/app.db

# 文件存储路径
UPLOAD_DIR=../uploads
OUTPUT_DIR=../outputs

# 服务端口，默认 8001
PORT=8001

# 用户登录 JWT 配置
# 安全密钥：长度 ≥ 32，可用 python -c "import secrets; print(secrets.token_hex(32))" 生成
JWT_SECRET_KEY=please_change_this_secret_in_production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10080

# 自动创建/同步一个管理员登录账号
ADMIN_USERNAME=superadmin
ADMIN_PHONE=13900000000
ADMIN_PASSWORD=please_change_admin_password

# 额外管理员白名单，支持英文逗号分隔多个用户名或手机号
ADMIN_USERNAMES=
ADMIN_PHONES=

# CORS 白名单，逗号分隔（留空则默认 * 仅适合开发环境，生产必须填写）
# 示例：CORS_ALLOWED_ORIGINS=https://yourapp.com,https://www.yourapp.com
CORS_ALLOWED_ORIGINS=http://localhost:5174
